
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,

    "types": [
      "node"
    ],

    "noEmit": true,
    "skipLibCheck": true,
    "strict": true
  },

  "include": [
    "vite.config.ts"
  ]
}
